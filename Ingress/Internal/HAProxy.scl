import Std/List
import Std/Option
import Std/Plugin
import Std/Str
import Std/Test
import Std/Dict
import Std/Secret
import Skyr/Container as C
import Skyr/Net

export type ConfigFile {
	sections: [ConfigSection],
}

export type ConfigSection {
	heading: ConfigStatement,
	statements: [ConfigStatement],
}

export type ConfigStatement {
	tokens: [Str],
	comment: Str?,
}

export let configBuilder = {
	comment: fn(comment: Str) { comment, tokens: [] } as ConfigStatement,
	statement: fn(tokens: Str) { tokens: Str.split(tokens, " ") } as ConfigStatement,
	section: fn(heading: ConfigStatement, statements: [ConfigStatement])
		{ heading, statements } as ConfigSection,
}

export let formatConfig: fn(ConfigFile) Str = fn(config)
	Str.join(List.map(config.sections, formatSection), "\n\n") + "\n"

let formatSection: fn(ConfigSection) Str = fn(section)
	Str.join(
		[
			formatStatement(section.heading),
			for (statement in section.statements) "\t" + formatStatement(statement),
		],
		"\n",
	)

let formatStatement: fn(ConfigStatement) Str = fn(stmt)
	let line = Str.join(stmt.tokens, " ");
	if (stmt.comment != nil)
		if (line == "")
			"# {stmt.comment}"
		else
			"{line} # {stmt.comment}"
	else
		line

/// The TLS material one terminating bind needs. The chain is public, so it
/// travels as PEM text; the key stays a Secret.Ref, whose plaintext is resolved
/// inside the platform when a pod materializes and never enters this program.
export type Certificate {
	certificatePem: Str,
	privateKey: Secret.Ref,
}

export type Config {
	version: Str,
	extraSections: [ConfigSection]?,
	frontends: #{Str: {
		/// The port the frontend listens on inside a pod. The image runs as an
		/// unprivileged user, which cannot bind a port below 1024.
		bind: Int,
		bindArgs: ConfigStatement?,
		/// The port of the pod's gateway that is forwarded to this frontend.
		/// Absent, the frontend is published nowhere and answers only on the
		/// pod's own address, to whatever shares its network.
		publicPort: Int?,
		statements: [ConfigStatement]?,
	}},
	backends: #{Str: [ConfigStatement]},
	/// Certificates to deliver to the pods, keyed by the name the certificate
	/// lists below refer to them by.
	certificates: #{Str: Certificate}?,
	/// The certificate lists to write, keyed by the name a `bind`'s `crt-list`
	/// argument refers to them by (see `certificateListPath`). A list may be
	/// empty: a bind that declares `strict-sni` and finds no certificate is a
	/// warning, not an error, and simply fails every handshake until one
	/// arrives.
	certificateLists: #{Str: [CertificateListEntry]}?,
}

/// One line of a certificate list: a certificate, and the SNI names that
/// select it. Absent any filter, the client's SNI is matched against the CN
/// and SANs the certificate itself carries.
export type CertificateListEntry {
	certificate: Str,
	sniFilters: [Str],
}

/// Where the config volume — which carries the certificates too — is mounted.
let configMountPath = "/usr/local/etc/haproxy"

/// The uid and gid the official `haproxy` image runs as (`USER haproxy`). A
/// volume is mounted owner-only, and owned by root unless its mount says
/// otherwise, so the mount has to name this identity or HAProxy can read
/// neither its config nor the keys delivered beside it.
let haproxyUser = 99

/// The key of a pod's one NIC, and of its gateway's attachment to the same
/// network.
let nicKey = "ingress"

/// A certificate's path within the config volume.
let certificateFile = fn(name: Str) "tls/{name}.pem"

/// The path a certificate list names certificate `name` by. The private key is
/// not in this file: HAProxy loads it from the `.key` beside it, which is how a
/// key that never enters SCL still reaches the same bind.
export let certificatePath = fn(name: Str) "{configMountPath}/{certificateFile(name)}"

/// A certificate list's path within the config volume.
let certificateListFile = fn(name: Str) "tls/{name}.list"

/// The path a `bind ... ssl crt-list` argument names list `name` by.
export let certificateListPath = fn(name: Str) "{configMountPath}/{certificateListFile(name)}"

/// One line per certificate: where it is, then the SNI names selecting it.
/// The paths are absolute because HAProxy resolves a relative crt-list entry
/// against its own working directory rather than the list's own location, and
/// so would not find the certificate sitting beside it.
let formatCertificateList: fn([CertificateListEntry]) Str = fn(entries)
	Str.join(
		[for (e in entries) Str.join([certificatePath(e.certificate), in e.sniFilters], " ")],
		"\n",
	) + "\n"

export type PodOptions {
	name: Str,
	cpu: Int,
	memory: Int,
	/// Bytes of local storage for the unpacked image and the container's
	/// writable root.
	scratch: Int,
	region: Str?,
	/// The network the pod's NIC is on: where it finds its backends, and where
	/// its gateway finds it. Dual-stack, since a gateway forwards each address
	/// family to an address of that same family.
	network: Net.Network,
	/// Publish the public frontends on the gateway's IPv4 address as well as
	/// its IPv6 one.
	withPublicIPv4: Bool?,
}

export let configSections: fn(Config) [ConfigSection] = fn(config)
	[
		if (config.extraSections != nil)
			in config.extraSections,
		// frontend sections
		for (feEntry in Dict.entries(config.frontends))
			{
				heading: configBuilder.statement("frontend {feEntry.key}"),
				statements: [
					// Dual-stack, on purpose. A gateway forwards each address family to
					// the pod's address of that same family, never translating between
					// them: a `*:` bind is IPv4-only, so it would refuse every
					// connection arriving over IPv6. `v4v6` keeps the IPv4 listener
					// regardless of the guest's `bindv6only`.
					{
						tokens: [
							"bind",
							":::{feEntry.value.bind}",
							"v4v6",
							if (feEntry.value.bindArgs != nil)
								in feEntry.value.bindArgs.tokens,
						],
						comment: if (feEntry.value.bindArgs != nil)
							feEntry.value.bindArgs.comment,
					},
					if (feEntry.value.statements != nil)
						in feEntry.value.statements,
				],
			},
		// backend sections
		for (beEntry in Dict.entries(config.backends))
			{
				heading: configBuilder.statement("backend {beEntry.key}"),
				statements: beEntry.value,
			},
	]

export let Proxy = fn(config: Config)
	let formattedConfig = formatConfig({ sections: configSections(config) });
	let certificates = config.certificates ?? #{};
	// One volume, so a rotated key or a rewritten config reaches the pods the
	// same way. It is mounted writable (below), which is what makes either
	// change recreate the replicas — HAProxy reads its config and loads its
	// certificates once, at startup, so a live re-projection would leave the
	// running process serving the old material. It is held in memory, the
	// default medium and the only one a `.secret` may be seeded into.
	let configVolume = C.ephemeralVolume({
		files: #{
			"haproxy.cfg": .literal(formattedConfig),
			for (e in Dict.entries(config.certificateLists ?? #{}))
				certificateListFile(e.key): .literal(formatCertificateList(e.value)),
			for (e in Dict.entries(certificates))
				certificateFile(e.key): .literal(e.value.certificatePem),
			for (e in Dict.entries(certificates))
				"{certificateFile(e.key)}.key": .secret(e.value.privateKey),
		},
	});
	// Fully qualified: a public image is pulled by the pod itself, through its
	// NIC and gateway, and names its registry outright.
	let image = "docker.io/library/haproxy:{config.version}-alpine";
	{
		formattedConfig,
		Pod: fn(opts: PodOptions)
			// A gateway of the pod's own, for two reasons. It is the pod's way
			// out, which pulling a public image needs; and a gateway forwards a
			// given public port to one target only, so it is also what gives
			// each pod a public address of its own to be reached on. It outlives
			// the pod: a config change replaces the pod, and the ports below
			// then follow the replacement to its new addresses.
			let gateway = Net.Gateway({
				name: opts.name,
				region: opts.region,
				networks: #{ nicKey: opts.network },
			});
			let pod = C.Pod({
				region: opts.region,
				name: opts.name,
				scratch: opts.scratch,
				nics: #{ nicKey: { network: opts.network } },
				gateway,
				containers: #{
					"haproxy": {
						image,
						cpu: opts.cpu,
						memory: opts.memory,
						mounts: #{
							configMountPath: {
								source: .volume(configVolume),
								userId: haproxyUser,
								groupId: haproxyUser,
							},
						},
					},
				},
			});
			let nic = pod.nics[nicKey];
			let targets = [
				if (opts.withPublicIPv4 ?? false)
					Option.unwrap(nic?.ipv4),
				Option.unwrap(nic?.ipv6),
			];
			with (
				[
					for (fe in Dict.values(config.frontends))
						if (fe.publicPort != nil)
							for (target in targets)
								// Destination-only translation, the default, so
								// HAProxy sees the client's own address. The
								// replies find their way back because the pod
								// routes through this same gateway.
								gateway.Port({
									protocol: .tcp,
									port: fe.publicPort,
									target,
									targetPort: fe.bind,
								}),
				]
			)
				{
					ipv4: if (opts.withPublicIPv4 ?? false)
						gateway.publicIpv4 ?? Plugin.pending,
					ipv6: gateway.publicIpv6 ?? Plugin.pending,
				},
	}

@test
Test.group(
	"HAProxy config format",
	fn()
		Test.it(
			"formats a simple config",
			fn()
				let b = configBuilder;
				Test.expect(
					formatConfig({
						sections: [
							b.section(
								b.statement("global"),
								[b.statement("daemon"), b.statement("maxconn 256")],
							),
							b.section(
								b.statement("defaults"),
								[
									b.statement("mode http"),
									b.statement("timeout connect 5000ms"),
									b.statement("timeout client 50000ms"),
									b.statement("timeout server 50000ms"),
								],
							),
							b.section(
								b.statement("frontend http-in"),
								[b.statement("bind *:80"), b.statement("default_backend servers")],
							),
							b.section(
								b.statement("backend servers"),
								[b.statement("server server1 127.0.0.1:8000 maxconn 32")],
							),
						],
					}),
				).toEqual(
					"global\n\tdaemon\n\tmaxconn 256\n\ndefaults\n\tmode http\n\ttimeout connect 5000ms\n\ttimeout client 50000ms\n\ttimeout server 50000ms\n\nfrontend http-in\n\tbind *:80\n\tdefault_backend servers\n\nbackend servers\n\tserver server1 127.0.0.1:8000 maxconn 32\n",
				),
		),
)
